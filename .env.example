# Root .env for docker compose. Optional: every value has a dev-only default
# in docker-compose.yml. Copy to .env only to override. Never commit .env.
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
MEDIA_DB_USER=postgres
MEDIA_DB_PASSWORD=postgres
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Shared HS256 secret until F3 moves tokens to RS256 + JWKS.
JWT_SECRET=local-development-secret
# Host ports, if something on your machine already uses the defaults.
AUTH_DB_PORT=5432
MEDIA_DB_PORT=5433
REDIS_PORT=6379
