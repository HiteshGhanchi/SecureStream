{
  "compilerOptions": {
    "target": "es2022",
    
    /* Reverted to CommonJS */
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },

  "include": [
    "src/**/*",
    "prisma/**/*",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules"]
}