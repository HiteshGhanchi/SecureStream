# Server Configuration
PORT=3001
NODE_ENV=development

# API Base URL (for client config)
API_BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:changeme@db:5432/streamflow

# S3 / MinIO Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# MinIO Specific (set both for development)
AWS_ENDPOINT=http://minio:9000
AWS_PRESIGN_ENDPOINT=http://localhost:9000

# S3 Buckets
S3_RAW_BUCKET=streamflow-raw-videos
S3_HLS_BUCKET=streamflow-hls-segments

# CORS
CORS_ORIGIN=http://localhost:5173

# Keycloak / Auth
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=streamflow
KEYCLOAK_CLIENT_ID=streamflow-backend

# Logging
LOG_LEVEL=info
